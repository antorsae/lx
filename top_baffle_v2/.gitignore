# CAD viewer caches (regenerated by the step tool alongside each .step)
.*.step.glb

# Workstation and Python caches (also covered by the parent repository, kept
# here so this project remains clean if extracted as a standalone repository).
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Makefile build stamps (any depth: state roots, stl/, wings/*/stl/)
**/.stamp
**/.stamp_*
**/.obiwan_stage/
.manifold-stamps/
.check-stamps/

# Local metadata, resumable logs, and verified incoming remote artifacts
.remote-cad/

# Review scratch is intentionally disposable. Curated, current CAD snapshots
# live under images/generated/ and wing release reviews live under wings/*.
review/*.png
review/*_snapshot_job.json
review/captive_magnet_slice_smoke/

# Plain G-code and per-STL slicer workspaces are reproducible but large.  The
# hash-backed JSON/CSV/Markdown summaries beside this directory remain
# reviewable release artifacts.
review/captive_magnet_slice_audit/slices/
review/captive_magnet_slice_audit_petg_gf_*/slices/

# Optional opposed-BMR Stock/Slim CAD children are first-class deliverables.
# Keep their compact hash/provenance JSON and stable ready project trackable,
# while excluding reproducible slicer workspaces and obsolete in-build review
# scratch. Curated family snapshots live under review/vase_tebm35c10_4/.
build/vase_TEBM35C10-4/*/slice_audit/
build/vase_TEBM35C10-4/review/
build/vase_TEBM35C10-4/*/.*.step.glb
!build/vase_TEBM35C10-4/*/*.json
!build/vase_TEBM35C10-4/*/*.gcode.3mf

# Release inputs/summaries are JSON by design; the repository root otherwise
# ignores generic extraction JSON files.
!captive_magnet_slicing_profile.json
!captive_magnet_slicing_profile_petg_gf.json
!captive_magnet_release_catalog.schema.json
!review/captive_magnet_release_catalog.json
!review/captive_magnet_slice_audit/captive_magnet_pause_manifest.json

# Local P2S print shelf.  The friendly source map and selection guide are
# reviewed in Git; its rendered STL/3MF delivery files and slicer workspace
# are reproducible local outputs and deliberately remain untracked.
to_print/*/stl/
to_print/*/3mf/
review/to_print_slice_workspace/
to_print/release_manifest.json
!to_print/catalog.json

# Adjacent front-down print authorities are part of every released STL.  The
# repository root ignores generic JSON, so explicitly keep all three release
# trees trackable rather than relying on force-add during promotion/commit.
!build/floor_stand/stl/*.print.json
!build/no_floor_stand/stl/*.print.json
!build/wings/*/stl/*.print.json
!build/*/support_blockers/*.support_blocker.json
!build/*/process_modifiers/*.modifier.json
!build/print_plates/**/*.plate.json

# The product catalog is deliberately JSON-backed and carries linked copies of
# the same print authorities. Keep it trackable despite the parent repository's
# generic *.json rule.
!artifacts/**/*.json
!artifacts/*.json

# Oversized generated CAD. GitHub rejects any blob over 100 MB, and these two
# families regularly exceed it: the review assemblies are ~128 MB each and are
# rewritten by every rebuild, and the graded wing plate swings between 35 MB
# and 103 MB with its mesh density. Both are review/delivery outputs that
# `make` regenerates, and their hashes are still recorded in the plate and
# artifact manifests, so provenance survives without the bytes in git.
build/*/obiwan_assembled.step
build/print_plates/obiwan/obiwan_graded_wings_split2_combo.stl
