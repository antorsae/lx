# H2C is the only supported manufacturing target.
H2C_PYTHON ?= $(if $(wildcard ../.venv/bin/python),../.venv/bin/python,python3)
H2C_GUARD := $(abspath scripts/run_memory_guarded.py)
H2C_RUN := $(H2C_PYTHON) $(H2C_GUARD) -- $(H2C_PYTHON)
.DEFAULT_GOAL := all
.PHONY: all help to_print to_print_validate h2c h2c_geometry h2c_prepare h2c_validate h2c_plates h2c_review h2c_docs iso_matrix
all to_print h2c:
	$(H2C_RUN) scripts/h2c_pipeline.py all
h2c_geometry:
	$(H2C_RUN) scripts/h2c_pipeline.py geometry
h2c_prepare:
	$(H2C_RUN) scripts/h2c_pipeline.py prepare
h2c_validate to_print_validate:
	$(H2C_RUN) scripts/h2c_pipeline.py validate
h2c_plates:
	$(H2C_RUN) scripts/h2c_pipeline.py plates
h2c_docs:
	$(H2C_RUN) scripts/h2c_pipeline.py docs
h2c_review:
	$(H2C_RUN) scripts/h2c_pipeline.py review
iso_matrix:
	$(H2C_RUN) scripts/gen_product_iso_matrix.py
help:
	@echo 'Only supported printer: H2C, two 0.6 mm High Flow nozzles'
	@echo 'make                 Build geometry, prepare, slice, audit and document all H2C parts'
	@echo 'make h2c_geometry    Regenerate changed native geometry and check interfaces'
	@echo 'make h2c_prepare     Prepare changed H2C projects; preserve current audited jobs'
	@echo 'make h2c_validate    Slice and audit changed H2C projects'
	@echo 'make h2c_plates      Combine audited parts into one multi-plate file per product and stand state'
	@echo 'make h2c_review      Refresh orthographic geometry review files'
	@echo 'make iso_matrix     Refresh product, tweeter and matching-wing comparisons'
	@echo 'make h2c_docs        Regenerate the H2C file guide'
	@echo 'make waveguide_study_broadband    Guarded acoustic study on Osado (512 GiB aggregate cap)'
	@echo 'make waveguide_study_benchmark    Compare serial/concurrent BEM throughput (30 physical cores max)'
	@echo 'make waveguide_study_reference    Replay the recovered exact V3 mesh and source controls on Osado'
	@echo 'make waveguide_study_numerics     Controlled fixed-boundary refinement on Osado'
	@echo 'make waveguide_study_controls     Separate quadrature and CHIEF checks on Osado'
	@echo 'make waveguide_study_diagnostics  Refresh provisional LR4 fits and fresh frozen-filter checks on Osado'
	@echo 'make waveguide_study_geometry     Explore independent 3D driver packing on Osado; no acoustic solve'
	@echo 'make waveguide_study_spatial_cad  Build fused 38-control spatial CAD on Osado; qualification separate'
	@echo 'make waveguide_study_spatial_acoustics  Admit native spatial CAD, build coupled mesh, optionally solve on Osado'
	@echo 'make waveguide_study_spatial_prototypes  Search driver/profile proposals, then build accepted native prototypes on Osado'
