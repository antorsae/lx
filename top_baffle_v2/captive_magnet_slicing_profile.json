{
  "schema_version": 1,
  "backend": "BambuStudio",
  "required_bambu_studio_version": "02.07.01.62",
  "printer": "Bambu Lab P2S 0.4 nozzle",
  "process": "0.16mm High Quality @BBL P2S",
  "filament": "Bambu PLA Tough+ @BBL P2S",
  "vendor": "BBL",
  "machine_preset": "machine/Bambu Lab P2S 0.4 nozzle.json",
  "process_preset": "process/0.16mm High Quality @BBL P2S.json",
  "filament_preset": "filament/Bambu PLA Tough+ @BBL P2S.json",
  "repo_overrides": {
    "machine": {
      "machine_pause_gcode": "M400 U1"
    },
    "process": {
      "wall_loops": "6",
      "top_shell_layers": "6",
      "bottom_shell_layers": "5",
      "outer_wall_speed": [
        "60",
        "60"
      ],
      "curr_bed_type": "Textured PEI Plate",
      "sparse_infill_pattern": "gyroid",
      "sparse_infill_density": "30%",
      "wall_generator": "arachne",
      "enable_support": "0",
      "support_on_build_plate_only": "0",
      "support_critical_regions_only": "0",
      "support_remove_small_overhang": "0",
      "precise_outer_wall": "1",
      "detect_thin_wall": "1",
      "ensure_vertical_shell_thickness": "enabled",
      "detect_narrow_internal_solid_infill": "1",
      "elefant_foot_compensation": "0.15",
      "xy_hole_compensation": "0"
    },
    "filament": {
      "nozzle_temperature": [
        "225",
        "225"
      ],
      "nozzle_temperature_initial_layer": [
        "225",
        "225"
      ],
      "fan_max_speed": [
        "60"
      ],
      "overhang_fan_speed": [
        "100"
      ],
      "filament_max_volumetric_speed": [
        "16",
        "16"
      ],
      "textured_plate_temp": [
        "55"
      ],
      "textured_plate_temp_initial_layer": [
        "55"
      ]
    }
  },
  "artifact_overrides": [
    {
      "match": {
        "state": "floor_stand",
        "variant": "Obi-Wan-split",
        "part": "obiwan_optional_lm_keyed_1_of_2_bottom"
      },
      "process": {
        "sparse_infill_pattern": "zig-zag",
        "sparse_infill_density": "100%",
        "enable_support": "1",
        "support_on_build_plate_only": "1",
        "support_critical_regions_only": "1",
        "support_remove_small_overhang": "1"
      }
    },
    {
      "match": {
        "state": "no_floor_stand",
        "variant": "Obi-Wan-split",
        "part": "obiwan_optional_lm_keyed_1_of_2_bottom"
      },
      "process": {
        "sparse_infill_density": "40%",
        "enable_support": "1",
        "support_on_build_plate_only": "1",
        "support_critical_regions_only": "1",
        "support_remove_small_overhang": "1"
      }
    },
    {
      "match": {
        "state": "floor_stand",
        "variant": "Obi-Wan-split",
        "part": "obiwan_optional_lm_keyed_2_of_2_top"
      },
      "process": {
        "enable_support": "1",
        "support_on_build_plate_only": "1",
        "support_critical_regions_only": "1",
        "support_remove_small_overhang": "1"
      }
    },
    {
      "match": {
        "state": "no_floor_stand",
        "variant": "Obi-Wan-split",
        "part": "obiwan_optional_lm_keyed_2_of_2_top"
      },
      "process": {
        "enable_support": "1",
        "support_on_build_plate_only": "1",
        "support_critical_regions_only": "1",
        "support_remove_small_overhang": "1"
      }
    },
    {
      "match": {
        "state": "floor_stand",
        "variant": "Obi-Wan",
        "part": "obiwan_core_2_of_2_um_carrier"
      },
      "process": {
        "sparse_infill_density": "40%",
        "enable_support": "1",
        "support_on_build_plate_only": "1",
        "support_critical_regions_only": "1",
        "support_remove_small_overhang": "1"
      }
    },
    {
      "match": {
        "state": "no_floor_stand",
        "variant": "Obi-Wan",
        "part": "obiwan_core_2_of_2_um_carrier"
      },
      "process": {
        "sparse_infill_density": "40%",
        "enable_support": "1",
        "support_on_build_plate_only": "1",
        "support_critical_regions_only": "1",
        "support_remove_small_overhang": "1"
      }
    }
  ],
  "requirements": {
    "printer_model": "Bambu Lab P2S",
    "nozzle_diameter_mm": 0.4,
    "layer_height_mm": 0.16,
    "first_layer_height_mm": 0.2,
    "wall_generator": "arachne",
    "outer_wall_line_width_mm": 0.42,
    "inner_wall_line_width_mm": 0.45,
    "support_enabled": false,
    "print_orientation": "front_face_down",
    "xy_hole_compensation_policy": "0 mm is mandatory for captive-magnet parts: Bambu Studio 02.07.01.62 deletes the 0.45 mm retaining skin at +0.05 mm; 0 mm preserves the retaining geometry, while Arachne variable-width generation and the independent toolpath audit require exactly one bounded retaining traversal"
  },
  "machine_bounds_mm": {
    "x": [0.0, 256.0],
    "y": [0.0, 256.0],
    "z": [0.0, 256.0]
  },
  "slicing": {
    "arrange": true,
    "auto_orient": false,
    "allow_rotations": false,
    "timeout_seconds": 7200
  },
  "magnet_insertion_pause": {
    "park_z_mm": 250.0,
    "z_travel_speed_mm_s": 20.0,
    "policy": "The P2S has a 256 mm Z envelope. At each captive-magnet insertion layer, raise the nozzle to Z=250 mm (which lowers the bed to within 6 mm of its lowest position), pause with M400 U1, then restore the exact insertion-layer Z before the next print move. No XY motion is injected."
  }
}
